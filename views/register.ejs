<!DOCTYPE html>
<html>

<head>
    <title>User Registration</title>
</head>

<body>

    <h1>User Registration</h1>

    <hr>

    <% if (error) { %>
        <p style="color:red;">
            <strong>
                <%= error %>
            </strong>
        </p>
        <% } %>

            <form action="/register" method="POST">

                <label>Name:</label>
                <input type="text" name="name">
                <br><br>

                <label>Email:</label>
                <input type="email" name="email">
                <br><br>

                <label>Age:</label>
                <input type="number" name="age">
                <br><br>

                <button type="submit">Register</button>

            </form>

</body>

</html>