<!DOCTYPE html>
<html>

<head>
    <title>
        <%= title %>
    </title>
</head>

<body>

    <h1>User List</h1>

    <hr>

    <% if (users.length===0) { %>

        <p>No users available.</p>

        <% } else { %>

            <ol>

                <% users.forEach(user=> { %>

                    <li>
                        <strong>
                            <%= user.name %>
                        </strong>
                        (<%= user.email %>) -
                            <%= user.age %> years
                    </li>

                    <% }); %>

            </ol>

            <p>
                <strong>Total users: <%= users.length %></strong>
            </p>

            <% } %>

</body>

</html>